# Build artifacts
/dist/
/build/
*.exe

# Python cache and packaging
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
.env
.env.*
!.env.example

# 企业知识库产物（向量库、模型缓存、原始文档不入库）
/company_kb/chroma_db/
/company_kb/models/
/company_kb/documents/
/company_kb/logs/
/company_kb/chat_history.db
/company_kb/chat_history.db-wal
/company_kb/chat_history.db-shm
/company_kb/_test_*.db*

# Runtime data
/tmp/
/temp/
/runtime/
/analytics/runtime/
/logs/
/output/
/zhengqi_visit_stats/output/
*.log

# Excel temporary files
~$*.xlsx

# assets: 仅保留模板「早会五张表.xlsx」，其他 Excel（含真实数据）一律不跟踪
/assets/*.xlsx
!/assets/早会五张表.xlsx

# Frontend build artifacts
/web_page/node_modules/
/web_page/dist/
/web_page/.vite/
/web_page/.env
/web_page/.env.*
!/web_page/.env.example

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# 音乐下载（本地使用，不纳入版本管理）
/music/

# 各模块运行时数据（数据库、上传文件、缓存）不入库
# 模板/代码保留，数据文件由各环境自行生成
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm
**/uploads/
**/cache/
/gaotao_stats/temp/

# 测试临时输出文件
test_*.txt
test_*.json
*_test_output.*

# 临时调试脚本（test_ 前缀视为临时，正式测试套件不受影响）
test_*.py
create_test_*.py

# 说明/架构文档（本地参考，不入库）
# README.md / RUNBOOK.md 正式文档不受影响
.plan*.md
**/*_SCHEMA.md
**/*_ARCHITECTURE.md
**/DATABASE_SCHEMA.md
**/SYSTEM_ARCHITECTURE.md
